# Free LLM via Groq (no card): console.groq.com -> API Keys
LLM_API_KEY=your_groq_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# free key: data.gov.in -> My Account
DATA_GOV_IN_API_KEY=your_key
# transport cost assumption, Rs per quintal per km (editable)
TRANSPORT_RS_PER_QTL_KM=0.25
